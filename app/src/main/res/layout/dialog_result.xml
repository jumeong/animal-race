<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:background="#2C2C2C"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:id="@+id/txtResultMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RACE OVER"
        android:textSize="30sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:fontFamily="@font/pfstardust"
        android:layout_marginBottom="15dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/layoutResultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="100">

            <LinearLayout
                android:id="@+id/layoutLeftColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingStart="140dp"
                android:gravity="end" />

            <LinearLayout
                android:id="@+id/layoutRightColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:gravity="start" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnRematch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REMATCH"
        android:textSize="18sp"
        android:fontFamily="@font/pfstardust"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FFC107" />

</LinearLayout>
